# Track the ordered nodes and directed edges in the currently loaded graph.
# IDs identify canonical graph objects; positions and cost come from the graph.
Route route
---
#result definition

# Error codes
uint16 NONE=0
uint16 GOAL_REJECTED=1
uint16 SEND_GOAL_FAILURE=2
uint16 UNKNOWN=400
uint16 TF_ERROR=401
uint16 NO_VALID_GRAPH=402
uint16 INDETERMINANT_NODES_ON_GRAPH=403
uint16 TIMEOUT=404
uint16 NO_VALID_ROUTE=405
uint16 OPERATION_FAILED=406
uint16 INVALID_EDGE_SCORER_USE=407
uint16 REROUTE_REQUIRED=408
uint16 BUSY=409

builtin_interfaces/Duration execution_duration
uint16 error_code 0
string error_msg
# IDs reported by operations when the external provider must replan.
uint32[] blocked_ids
---
#feedback definition
uint16 last_node_id
uint16 next_node_id
uint16 current_edge_id
Route route
nav_msgs/Path path
string[] operations_triggered
